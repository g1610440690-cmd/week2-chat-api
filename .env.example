# ============ 复制本文件为 .env 后按需修改 ============
# 注意：.env 包含密钥，绝不能提交到 GitHub（.gitignore 已忽略）

# 数据库连接串（Docker Compose 启动时会被自动覆盖为容器内地址，无需改）
# 本地不用 Docker 时，可改成 SQLite：sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://chat:chatpass@localhost:5432/chatdb

# Redis 地址；留空表示禁用 Redis（限流/缓存降级，本地无 Redis 也能跑）
REDIS_URL=redis://localhost:6379/0

# JWT 签名密钥：生产环境务必改成足够长的随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# 限流：每个用户每分钟最多请求次数（走 Redis 计数）
RATE_LIMIT_PER_MINUTE=30

# 文件上传限制与目录
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads

# 可选：接入真实 LLM（留空则使用内置模拟回复）
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
